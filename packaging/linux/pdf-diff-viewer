#!/usr/bin/env sh
set -eu

if [ -z "${APPDIR:-}" ]; then
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  APPDIR=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
  export APPDIR
fi

export PYTHONHOME="${PYTHONHOME:-$APPDIR/usr}"
export PYTHONPATH="$APPDIR/usr/lib/python3.12/site-packages:$APPDIR/usr/lib/python3.12/dist-packages:$APPDIR/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$APPDIR/opt/libc/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$APPDIR/usr/local/bin:$APPDIR/usr/bin:$PATH"

exec "$APPDIR/opt/libc/usr/lib64/ld-linux-x86-64.so.2" \
  --library-path "$APPDIR/opt/libc/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
  "$APPDIR/usr/bin/python3" "$APPDIR/usr/src/pdf-diff-viewer/pdf_viewer_app.py" "$@"
